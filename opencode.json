{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "confluence": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "atlassian-confluence-mcp-server@latest"
      ],
      "environment": {
        "CONFLUENCE_BASE_URL": "<REDACTED>",
        "CONFLUENCE_USERNAME": "<REDACTED>",
        "PAT": "<REDACTED>"
      },
      "enabled": true
    },
    "obsidian": {
      "type": "local",
      "command": [
        "npx",
        "@bitbonsai/mcpvault@latest",
        "/home/br4vetrave1er/Documents/br4vetrave1er notes"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_TOKEN": "<REDACTED>"
      },
      "enabled": true
    },
    "postman": {
      "type": "remote",
      "url": "https://mcp.postman.com/mcp",
      "enabled": true
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": true
    }
  },
  "agent": {
    "readiness-analyzer": {
      "description": "Analyze any API for AI agent compatibility. Scans OpenAPI specs across 8 pillars (48 checks), scores agent-readiness, and provides fix recommendations.",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "pr-babysitter": {
      "description": "Keep a PR merge-ready by triaging comments, resolving conflicts, and fixing CI in a loop.",
      "mode": "subagent",
      "permission": {
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "split-to-prs": {
      "description": "Split a large change into multiple PRs with proper commit boundaries.",
      "mode": "subagent",
      "permission": {
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  },
  "permission": {
    "*": "allow"
  }
}
